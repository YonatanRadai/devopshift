pipeline {
    agent any
    triggers {
        githubPush()
    }
    environment {



        DOCKERHUB_CREDENTIALS = credentials('docker-hub-creds')
        DOCKER_REGISTRY = 'jonathanmradai'
        REPO_NAME = 'fe-exam'  // Change to 'be-exam' for backend pipeline
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        //my addiction 
        PROJECT = "fe"
        DOCKERHUB_USER = 'jonathanmradai'
        DOCKERHUB_CREDENTIALS_PSW = credentials("yonatan's token")
    }
    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'workshop/argo-jenkins-exam', url: 'https://github.com/YonatanRadai/devopshift.git'
            }
        }
        stage('Lint & Security Scan') {
            parallel {
                stage('Lint') {
                    steps {
                        dir("exam-code/docker/${env.PROJECT}/src") { 
                            sh '''
                            pip3 install flake8 
                            flake8 . || true
                            '''
                        }
                    }
                }
                stage('Security Scan') {
                    steps {
                        dir("exam-code/docker/${env.PROJECT}/src") { 
                            sh '''
                            pip install bandit 
                            bandit -r . || true
                            '''
                        }
                    }
                }
            }
        }
        stage('Install Dependencies') {
            steps {
                dir("exam-code/docker/${env.PROJECT}") {
                    sh 'pip install -r requirements.txt'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir("exam-code/docker/${env.PROJECT}") {
                    sh '''
                    docker build -t $DOCKER_REGISTRY/$REPO_NAME:$BUILD_NUMBER .
                    docker tag $DOCKER_REGISTRY/$REPO_NAME:$BUILD_NUMBER $DOCKER_REGISTRY/$REPO_NAME:latest
                    '''
                }
            }
        }
        stage('Run Tests in Container'){
            steps{
                sh '''
                 docker run --rm $DOCKER_REGISTRY/$REPO_NAME:$BUILD_NUMBER pytest tests/
                '''
            }
        }
        stage('Install Docker Compose') {
            steps {
                sh '''
                # Install docker-compose if not installed
                if ! command -v docker-compose &> /dev/null
                then
                    echo "Installing Docker Compose..."
                    curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
                    chmod +x /usr/local/bin/docker-compose
                    
                    # Create a symlink only if it doesn't exist
                    if [ ! -f /usr/bin/docker-compose ]; then
                        ln -s /usr/local/bin/docker-compose /usr/bin/docker-compose
                    fi
                else
                    echo "Docker Compose is already installed."
                fi

                # Verify installation
                docker-compose --version
                '''
            }
        }


        stage('Integration Test with Docker Compose'){
            steps{
                dir("exam-code/docker") {
                    sh '''
                    docker-compose up -d
                    sleep 20  # Allow services to start
                    # sh 'docker ps | grep -q 5002 && echo "Port 5002 is mapped and the container is running." ' // Adjust port for backend if needed
                    docker-compose down
                    '''
                }               
            }
        }

        stage('Push to Docker Hub'){
            steps{
                sh '''
                echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_USER --password-stdin
                docker push $DOCKER_REGISTRY/$REPO_NAME:$BUILD_NUMBER
                docker push $DOCKER_REGISTRY/$REPO_NAME:latest
                '''
            }
        }
    }
}